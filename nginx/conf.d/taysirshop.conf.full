# Reverse proxy nginx -> conteneur prestashop (port 80 interne).
# Adapter server_name si le nom de domaine change.

server {
    listen 80;
    server_name taysirshop.shop www.taysirshop.shop;

    # Necessaire pour que certbot puisse valider le domaine (challenge HTTP)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Tout le reste du trafic HTTP est renvoye vers HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name taysirshop.shop www.taysirshop.shop;

    ssl_certificate     /etc/letsencrypt/live/taysirshop.shop/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/taysirshop.shop/privkey.pem;

    # Taille max d'upload (photos produits depuis le back-office, etc.)
    client_max_body_size 64M;

    location / {
        proxy_pass http://prestashop:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
